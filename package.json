{
  "name": "putzplan",
  "version": "1.0.0",
  "private": true,
  "description": "Automatischer Putzplan für dein Zuhause (Web-App und Android-App)",
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "test": "node --test tests/*.test.js",
    "build:web": "node scripts/build-web.js",
    "android:sync": "npm run build:web && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
